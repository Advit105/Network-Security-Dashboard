# ══════════════════════════════════════════════════════════════
#  Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
#  Generate strong secrets:  python -c "import secrets; print(secrets.token_urlsafe(64))"
#  Generate a Fernet key:     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ══════════════════════════════════════════════════════════════

# App
ENVIRONMENT=development          # development | production
APP_NAME=SentinelX Auth API
API_V1_PREFIX=/api/v1

# Server-side secrets (each MUST be unique, long, random, and secret)
JWT_SECRET=change-me-to-a-64-char-random-string
FERNET_KEY=change-me-to-a-generated-fernet-key   # encrypts TOTP secrets at rest

# Database (parameterized access only, via SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_auth

# Token lifetimes
ACCESS_TOKEN_TTL_SECONDS=900       # 15 min — short-lived access JWT
REFRESH_TOKEN_TTL_SECONDS=604800   # 7 days — opaque, rotated, server-revocable
PASSWORD_RESET_TTL_SECONDS=1800    # 30 min — single-use reset token

# Account lockout
MAX_FAILED_LOGINS=5
LOCKOUT_SECONDS=900                # 15 min lock after MAX_FAILED_LOGINS

# Cookies
COOKIE_SECURE=false                # MUST be true in production (HTTPS only)
COOKIE_DOMAIN=                     # e.g. .example.com in production

# CORS — comma-separated exact origins (never "*" with credentials)
CORS_ORIGINS=http://localhost:8741,http://localhost:5173

# Rate limiting (use redis:// in production for a shared limiter)
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_ENABLED=true            # set false only for tests / load-testing

# Email (password reset). In development, emails are printed to the console.
EMAIL_TRANSPORT=console            # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@sentinelx.local
FRONTEND_RESET_URL=http://localhost:8741/reset-password
